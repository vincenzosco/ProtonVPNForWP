<Page
    x:Class="Proton_VPN_WP.Views.ServerDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource ProtonBackgroundBrush}">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,20,20,32">

                <TextBlock x:Name="NameText" Text="Server" Style="{StaticResource ProtonPageTitle}" AutomationProperties.Name="DetailServerName" />
                <TextBlock x:Name="LocationText" Text="—" Style="{StaticResource ProtonSubtitle}" AutomationProperties.Name="DetailLocation" />

                <Border Style="{StaticResource ProtonCard}" Margin="0,16,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="STATUS" Style="{StaticResource ProtonSectionHeader}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" x:Name="StatusText" Text="—" Style="{StaticResource ProtonBody}" AutomationProperties.Name="DetailStatus" />

                        <TextBlock Grid.Row="0" Grid.Column="1" Text="LOAD" Style="{StaticResource ProtonSectionHeader}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="LoadText" Text="—" Style="{StaticResource ProtonBody}" AutomationProperties.Name="DetailLoad" />
                    </Grid>
                </Border>

                <TextBlock x:Name="FeatureText" Text="Standard" Style="{StaticResource ProtonCaption}" />
                <TextBlock x:Name="TierText" Text="Free" Style="{StaticResource ProtonCaption}" Margin="0,2,0,0" />
                <TextBlock x:Name="HostText" Text="—" Style="{StaticResource ProtonCaption}" Margin="0,2,0,0" TextWrapping="Wrap" AutomationProperties.Name="DetailHostName" />

                <TextBlock Text="PHYSICAL NODES" Style="{StaticResource ProtonSectionHeader}" Margin="0,18,0,4" />
                <ListView x:Name="PhysicalList"
                          SelectionMode="None"
                          IsItemClickEnabled="False"
                          AutomationProperties.Name="PhysicalServerList">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource ProtonSurfaceBrush}"
                                    CornerRadius="6"
                                    Margin="0,3,0,3"
                                    Padding="14,10,14,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding Domain}"
                                               Foreground="{StaticResource ProtonTextBrush}"
                                               FontSize="16"
                                               FontFamily="Consolas"
                                               TextWrapping="Wrap" />
                                    <TextBlock Foreground="{StaticResource ProtonTextMutedBrush}"
                                               FontSize="12"
                                               Margin="0,2,0,0">
                                        <Run Text="entry " />
                                        <Run Text="{Binding EntryIp}" />
                                        <Run Text="  ·  exit " />
                                        <Run Text="{Binding ExitIp}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Button x:Name="UseButton"
                        Content="Use this server"
                        Style="{StaticResource ProtonPrimaryButton}"
                        Click="OnUseClick"
                        AutomationProperties.Name="UseServerButton" />

                <Button x:Name="MeasureButton"
                        Content="Measure latency"
                        Style="{StaticResource ProtonSecondaryButton}"
                        Click="OnMeasureClick"
                        AutomationProperties.Name="MeasureLatencyButton" />

                <TextBlock x:Name="LatencyText" Text="" Style="{StaticResource ProtonCaption}" Margin="0,8,0,0" AutomationProperties.Name="LatencyResult" />

                <TextBlock x:Name="NoticeText"
                           Style="{StaticResource ProtonCaption}"
                           Foreground="{StaticResource ProtonWarningBrush}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Margin="0,8,0,0" />

            </StackPanel>
        </ScrollViewer>

        <ProgressRing x:Name="BusyRing"
                      IsActive="False"
                      Foreground="{StaticResource ProtonAccentBrush}"
                      Width="34" Height="34" />
    </Grid>
</Page>
