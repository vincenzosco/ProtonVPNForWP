<Page
    x:Class="Proton_VPN_WP.Views.ServersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource ProtonBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="20,20,20,8">
            <TextBlock Text="Servers" Style="{StaticResource ProtonPageTitle}" />

            <TextBox x:Name="SearchBox"
                     PlaceholderText="Search country, city or feature"
                     TextChanged="OnSearchTextChanged"
                     Background="{StaticResource ProtonSurfaceBrush}"
                     Foreground="{StaticResource ProtonTextBrush}"
                     BorderBrush="{StaticResource ProtonDividerBrush}"
                     Margin="0,8,0,0"
                     AutomationProperties.Name="ServerSearchBox" />

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SummaryText"
                           Grid.Column="0"
                           Text="—"
                           Style="{StaticResource ProtonCaption}"
                           VerticalAlignment="Center"
                           AutomationProperties.Name="ServerSummary" />
                <ToggleSwitch x:Name="FreeOnlySwitch"
                              Grid.Column="1"
                              IsOn="False"
                              OnContent="Free"
                              OffContent="All"
                              Toggled="OnFreeOnlyToggled"
                              AutomationProperties.Name="FreeOnlySwitch" />
            </Grid>
        </StackPanel>

        <Grid Grid.Row="1">
            <ListView x:Name="ServerList"
                      Margin="12,0,12,0"
                      SelectionMode="Single"
                      IsItemClickEnabled="True"
                      ItemClick="OnServerClick"
                      AutomationProperties.Name="ServerList">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource ProtonSurfaceBrush}"
                                CornerRadius="6"
                                Margin="4,4,4,4"
                                Padding="14,12,14,12">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}"
                                           Foreground="{StaticResource ProtonTextBrush}"
                                           FontSize="19"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding LocationText}"
                                           Foreground="{StaticResource ProtonTextMutedBrush}"
                                           FontSize="14"
                                           Margin="0,2,0,0" />
                                <TextBlock Foreground="{StaticResource ProtonTextMutedBrush}"
                                           FontSize="12"
                                           Margin="0,4,0,0">
                                    <Run Text="{Binding TierText}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding LoadText}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding StatusText}" />
                                </TextBlock>
                                <TextBlock Text="{Binding FeatureText}"
                                           Foreground="{StaticResource ProtonAccentBrush}"
                                           FontSize="12"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ProgressRing x:Name="BusyRing"
                          IsActive="False"
                          Foreground="{StaticResource ProtonAccentBrush}"
                          Width="34" Height="34" />

            <TextBlock x:Name="EmptyText"
                       Text="No server matches this search."
                       Style="{StaticResource ProtonCaption}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed" />
        </Grid>
    </Grid>
</Page>
