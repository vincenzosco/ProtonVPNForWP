<Page
    x:Class="Proton_VPN_WP.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource ProtonBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,28,20,32">

            <Image Source="ms-appx:///Assets/ProtonLogo.png"
                   Width="96"
                   Height="96"
                   HorizontalAlignment="Left"
                   Margin="0,0,0,12" />

            <TextBlock Text="Proton VPN"
                       Style="{StaticResource ProtonPageTitle}"
                       AutomationProperties.Name="ProtonVPNTitle" />

            <TextBlock x:Name="SubtitleText"
                       Text="Sign in to your Proton account to load your servers and generate a profile."
                       Style="{StaticResource ProtonSubtitle}" />

            <TextBlock x:Name="PlatformNoticeText"
                       Style="{StaticResource ProtonCaption}"
                       Margin="0,14,0,0"
                       Text="Windows Phone 8.1 has no VPN programming interface, so this app prepares the profile and Windows opens the tunnel from its built-in VPN." />

            <TextBlock Text="USERNAME" Style="{StaticResource ProtonSectionHeader}" />
            <TextBox x:Name="UsernameBox"
                     Style="{StaticResource ProtonTextBox}"
                     PlaceholderText="you@proton.me or username"
                     AutomationProperties.Name="UsernameBox" />

            <TextBlock Text="PASSWORD" Style="{StaticResource ProtonSectionHeader}" />
            <PasswordBox x:Name="PasswordEntry"
                         Style="{StaticResource ProtonPasswordBox}"
                         AutomationProperties.Name="PasswordBox" />

            <StackPanel x:Name="TwoFactorPanel" Visibility="Collapsed">
                <TextBlock Text="TWO-FACTOR CODE" Style="{StaticResource ProtonSectionHeader}" />
                <TextBox x:Name="TwoFactorBox"
                         Style="{StaticResource ProtonTextBox}"
                         InputScope="Number"
                         MaxLength="12"
                         AutomationProperties.Name="TwoFactorBox" />
            </StackPanel>

            <Button x:Name="SignInButton"
                    Content="Sign in"
                    Style="{StaticResource ProtonPrimaryButton}"
                    Click="OnSignInClick"
                    AutomationProperties.Name="SignInButton" />

            <Button x:Name="OfflineButton"
                    Content="Continue without an account"
                    Style="{StaticResource ProtonSecondaryButton}"
                    Click="OnOfflineClick"
                    AutomationProperties.Name="OfflineButton" />

            <ProgressRing x:Name="BusyRing"
                          IsActive="False"
                          Foreground="{StaticResource ProtonAccentBrush}"
                          Width="32"
                          Height="32"
                          Margin="0,16,0,0"
                          HorizontalAlignment="Left" />

            <TextBlock x:Name="StatusText"
                       Style="{StaticResource ProtonCaption}"
                       Margin="0,10,0,0"
                       TextWrapping="Wrap" />

            <TextBlock x:Name="ErrorText"
                       Foreground="{StaticResource ProtonDangerBrush}"
                       Style="{StaticResource ProtonCaption}"
                       Margin="0,10,0,0"
                       Visibility="Collapsed"
                       TextWrapping="Wrap"
                       AutomationProperties.Name="LoginErrorText" />

        </StackPanel>
    </ScrollViewer>
</Page>
