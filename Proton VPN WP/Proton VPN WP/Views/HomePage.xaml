<Page
    x:Class="Proton_VPN_WP.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource ProtonBackgroundBrush}">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,24,20,32">

                <TextBlock Text="Proton VPN" Style="{StaticResource ProtonPageTitle}" />
                <TextBlock x:Name="AccountText"
                           Text="Not signed in"
                           Style="{StaticResource ProtonSubtitle}"
                           AutomationProperties.Name="AccountLine" />

                <Border Style="{StaticResource ProtonCard}" Margin="0,18,0,12">
                    <StackPanel>
                        <TextBlock Text="CONNECTION" Style="{StaticResource ProtonSectionHeader}" Margin="0,0,0,6" />
                        <TextBlock x:Name="SelectionText"
                                   Text="No server selected yet."
                                   Style="{StaticResource ProtonBody}"
                                   AutomationProperties.Name="SelectionLine" />
                        <TextBlock Text="Windows Phone opens the tunnel from its built-in VPN. This app prepares the profile."
                                   Style="{StaticResource ProtonCaption}"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock Text="STATUS" Style="{StaticResource ProtonSectionHeader}" />
                <TextBlock x:Name="NetworkText" Text="Checking network…" Style="{StaticResource ProtonCaption}" />
                <TextBlock x:Name="CatalogueText" Text="Loading servers…" Style="{StaticResource ProtonCaption}" Margin="0,4,0,0" />

                <TextBlock x:Name="NoticeText"
                           Style="{StaticResource ProtonCaption}"
                           Foreground="{StaticResource ProtonWarningBrush}"
                           Margin="0,8,0,0"
                           Visibility="Collapsed"
                           TextWrapping="Wrap" />

                <Button x:Name="QuickConnectButton"
                        Content="Quick connect (fastest server)"
                        Style="{StaticResource ProtonPrimaryButton}"
                        Click="OnQuickConnectClick"
                        AutomationProperties.Name="QuickConnectButton" />

                <Button x:Name="ServersButton"
                        Content="Choose a server"
                        Style="{StaticResource ProtonSecondaryButton}"
                        Click="OnServersClick"
                        AutomationProperties.Name="ServersButton" />

                <Button x:Name="ProfileButton"
                        Content="Profile &amp; setup instructions"
                        Style="{StaticResource ProtonSecondaryButton}"
                        Click="OnProfileClick"
                        AutomationProperties.Name="ProfileButton" />

                <Button x:Name="SettingsButton"
                        Content="Settings"
                        Style="{StaticResource ProtonSecondaryButton}"
                        Click="OnSettingsClick"
                        AutomationProperties.Name="SettingsLinkButton" />

                <Button x:Name="AboutButton"
                        Content="About &amp; limitations"
                        Style="{StaticResource ProtonSecondaryButton}"
                        Click="OnAboutClick"
                        AutomationProperties.Name="AboutButton" />

                <ProgressRing x:Name="BusyRing"
                              IsActive="False"
                              Foreground="{StaticResource ProtonAccentBrush}"
                              Width="32" Height="32"
                              Margin="0,16,0,0"
                              HorizontalAlignment="Left" />

                <TextBlock x:Name="StatusText" Style="{StaticResource ProtonCaption}" Margin="0,10,0,0" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
