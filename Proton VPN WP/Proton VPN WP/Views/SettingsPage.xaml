<Page
    x:Class="Proton_VPN_WP.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource ProtonBackgroundBrush}">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,20,20,40">

                <TextBlock Text="Settings" Style="{StaticResource ProtonPageTitle}" />

                <TextBlock Text="ACCOUNT" Style="{StaticResource ProtonSectionHeader}" Margin="0,16,0,6" />
                <TextBlock x:Name="AccountText" Text="Not signed in" Style="{StaticResource ProtonBody}" AutomationProperties.Name="SettingsAccount" />
                <Button x:Name="SignInButton" Content="Sign in" Style="{StaticResource ProtonPrimaryButton}" Click="OnSignInClick" AutomationProperties.Name="SettingsSignInButton" />
                <Button x:Name="SignOutButton" Content="Sign out and forget secrets" Style="{StaticResource ProtonSecondaryButton}" Click="OnSignOutClick" AutomationProperties.Name="SettingsSignOutButton" />

                <TextBlock Text="OPENVPN / IKEV2 CREDENTIALS" Style="{StaticResource ProtonSectionHeader}" Margin="0,22,0,6" />
                <TextBlock Style="{StaticResource ProtonCaption}"
                           TextWrapping="Wrap"
                           Text="These are NOT your Proton password. Get them from account.protonvpn.com → OpenVPN / IKEv2 username. They are encrypted on device with DataProtectionProvider." />
                <TextBox x:Name="VpnUserBox" Header="OpenVPN user name" TextChanged="OnCredentialChanged" Background="{StaticResource ProtonSurfaceBrush}" Foreground="{StaticResource ProtonTextBrush}" AutomationProperties.Name="VpnUsernameBox" />
                <PasswordBox x:Name="VpnPasswordBox" Header="OpenVPN password" PasswordChanged="OnCredentialPasswordChanged" Background="{StaticResource ProtonSurfaceBrush}" Foreground="{StaticResource ProtonTextBrush}" AutomationProperties.Name="VpnPasswordInput" />

                <TextBlock Text="DEFAULT PROTOCOL" Style="{StaticResource ProtonSectionHeader}" Margin="0,22,0,6" />
                <RadioButton x:Name="IkeRadio" Content="IKEv2 / IPsec (recommended on Windows Phone)" GroupName="protocol" IsChecked="True" Checked="OnProtocolChanged" AutomationProperties.Name="ProtocolIkev2" />
                <RadioButton x:Name="OpenVpnRadio" Content="OpenVPN (config export)" GroupName="protocol" Checked="OnProtocolChanged" AutomationProperties.Name="ProtocolOpenVpn" />

                <TextBlock Text="SERVER LIST" Style="{StaticResource ProtonSectionHeader}" Margin="0,22,0,6" />
                <ToggleSwitch x:Name="AutoRefreshSwitch" Header="Refresh from Proton when online" OnContent="On" OffContent="Off" Toggled="OnAutoRefreshToggled" AutomationProperties.Name="AutoRefreshSwitch" />
                <ToggleSwitch x:Name="FreeOnlySwitch" Header="Default to free servers only" OnContent="On" OffContent="Off" Toggled="OnFreeOnlyToggled" AutomationProperties.Name="SettingsFreeOnlySwitch" />
                <TextBlock x:Name="CatalogueText" Text="—" Style="{StaticResource ProtonCaption}" Margin="0,6,0,0" AutomationProperties.Name="SettingsCatalogueState" />
                <Button x:Name="RefreshButton" Content="Refresh server list now" Style="{StaticResource ProtonSecondaryButton}" Click="OnRefreshClick" AutomationProperties.Name="RefreshCatalogueButton" />
                <Button x:Name="ClearCacheButton" Content="Clear cached server list" Style="{StaticResource ProtonSecondaryButton}" Click="OnClearCacheClick" AutomationProperties.Name="ClearCacheButton" />

                <TextBlock Text="NETWORK DIAGNOSTICS" Style="{StaticResource ProtonSectionHeader}" Margin="0,22,0,6" />
                <ListView x:Name="DiagnosticsList" SelectionMode="None" IsItemClickEnabled="False" AutomationProperties.Name="DiagnosticsList" />

                <TextBlock Text="RESET" Style="{StaticResource ProtonSectionHeader}" Margin="0,22,0,6" />
                <TextBlock Style="{StaticResource ProtonCaption}" TextWrapping="Wrap" Text="Erases preferences, cached servers and every stored secret on this device." />
                <Button x:Name="ResetButton" Content="Erase all app data" Style="{StaticResource ProtonDangerButton}" Click="OnResetClick" AutomationProperties.Name="ResetAppButton" />

                <TextBlock x:Name="StatusText" Style="{StaticResource ProtonCaption}" Margin="0,14,0,0" TextWrapping="Wrap" AutomationProperties.Name="SettingsStatus" />

            </StackPanel>
        </ScrollViewer>

        <ProgressRing x:Name="BusyRing" IsActive="False" Foreground="{StaticResource ProtonAccentBrush}" Width="34" Height="34" />
    </Grid>
</Page>
